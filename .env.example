# Copy to .env (never commit real keys). The CLI loads .env automatically.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # required for org-level keys not scoped to a workspace
# Optional overrides
# SDLC_MODEL=claude-opus-5-5          # primary agent model
# SDLC_FALLBACK_MODEL=claude-opus-5-5 # used (at effort xhigh) from the escalation attempt on
# SDLC_PROVIDER=anthropic             # or: openai (OpenAI-compatible: OpenAI, Gemini, Ollama, vLLM)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# SDLC_HOME=.sdlc                     # state db, run workspaces, transcripts, releases
# SDLC_DASHBOARD_TOKEN=change-me      # require X-SDLC-Token on dashboard POSTs
